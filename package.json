{
  "name": "research-digital-portfolio",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "AP Research digital portfolio: epoxy-sealed 3D-printed PLA and repeated alcohol disinfection.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "sources": "node scripts/build-sources.mjs",
    "check": "node scripts/check-dist.mjs",
    "test": "node --test tests/sources.test.mjs",
    "verify": "npm run build && npm run check && npm run test && npm run test:e2e",
    "test:e2e": "node --test tests/e2e.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "astro": "^7.4.13"
  },
  "devDependencies": {
    "exceljs": "^4.4.0",
    "sharp": "^0.35.5"
  }
}
