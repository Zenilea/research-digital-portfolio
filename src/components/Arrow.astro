---
// A small arrow drawn as SVG so it looks the same in every font.
interface Props {
  dir?: 'right' | 'up' | 'down';
}
const { dir = 'right' } = Astro.props;
const rotate = { right: 0, up: -90, down: 90 }[dir];
---

<svg
  class="arrow"
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  style={rotate ? `rotate:${rotate}deg` : undefined}
>
  <path d="M2 8h11M9 3.5 13.5 8 9 12.5"></path>
</svg>
