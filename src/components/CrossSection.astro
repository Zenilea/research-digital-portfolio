---
// A drawing of a slice through a 3D-printed part.
// It shows the idea only. It is not data and is always labelled that way.
//
// step 1  the printed lines and the gaps between them
// step 2  liquid seeps down through the gaps
// step 3  a coat of epoxy closes the surface
// step 4  liquid beads up on the coat and stays out
// step 5  the same, repeated 20 times: does the seal last?
interface Props {
  step: 1 | 2 | 3 | 4 | 5;
  label: string;
}
const { step, label } = Astro.props;

const W = 96; // width of one printed line
const H = 38;
const PITCH = 104; // leaves an 8 unit gap
const TOP = 170;
const ROW = 40;

const row = (y: number, shifted: boolean) =>
  Array.from({ length: 10 }, (_, i) => ({ x: -44 + (shifted ? -52 : 0) + i * PITCH, y }));

const surface = row(TOP, false);
const body = [...row(TOP + ROW, true), ...row(TOP + 2 * ROW, false)];
const base = [...row(412, true), ...row(452, false)];

// Paths a liquid could take from the surface down into the hollow middle.
const leaks = [
  { d: 'M160 166V209H212V249H264V300', drip: 264 },
  { d: 'M472 166V209H420V249H368V300', drip: 368 },
  { d: 'M576 166V209H628V249H680V300', drip: 680 },
];
const entries = [160, 472, 576];
const ticks = Array.from({ length: 20 }, (_, i) => i);

const sealed = step >= 3;
---

<svg class={`cs cs--${step}`} viewBox="0 0 800 500" role="img" aria-label={label}>
  <!-- inside of the part -->
  <g class="cs__beads">
    {body.map((b) => <rect x={b.x} y={b.y} width={W} height={H} rx={H / 2} />)}
    {base.map((b) => <rect x={b.x} y={b.y} width={W} height={H} rx={H / 2} />)}
  </g>
  <polyline class="cs__infill-edge" points="-40,412 60,292 160,412 260,292 360,412 460,292 560,412 660,292 760,412 860,292" />
  <polyline class="cs__infill" points="-40,412 60,292 160,412 260,292 360,412 460,292 560,412 660,292 760,412 860,292" />

  <!-- the epoxy sits behind the top row, so it fills the dips between the lines -->
  {sealed && <rect class="cs__coat" x="-10" y="153" width="820" height="38" />}

  <g class="cs__beads">
    {surface.map((b) => <rect x={b.x} y={b.y} width={W} height={H} rx={H / 2} />)}
  </g>
  {sealed && <line class="cs__coat-edge" x1="-10" y1="153" x2="810" y2="153" />}

  {
    step === 1 && (
      <g class="cs__marks">
        {entries.map((x, i) => <circle cx={x} cy="186" r="15" style={`--i:${i}`} />)}
      </g>
    )
  }

  {
    step === 2 && (
      <g>
        {leaks.map((leak, i) => (
          <g style={`--i:${i}`}>
            <path class="cs__leak" d={leak.d} pathLength="1" />
            <circle class="cs__drip" cx={leak.drip} cy="338" r="5.5" />
            <path class="cs__pool" d={`M${leak.drip - 30} 411q30 -20 60 0z`} />
          </g>
        ))}
        {entries.map((x, i) => (
          <path class="cs__drop cs__drop--in" style={`--i:${i}`} d={`M${x} 110c9 14 13 21 13 29a13 13 0 0 1 -26 0c0 -8 4 -15 13 -29z`} />
        ))}
      </g>
    )
  }

  {
    step >= 4 && (
      <g>
        {entries.map((x, i) => (
          <g class="cs__bead-drop" style={`--i:${i}`}>
            <path d={`M${x - 26} 153a26 21 0 0 1 52 0z`} />
            <path class="cs__glint" d={`M${x - 15} 144a15 11 0 0 1 12 -9`} />
          </g>
        ))}
      </g>
    )
  }

  {
    step === 5 && (
      <g>
        <text class="cs__times" x="34" y="92">×20</text>
        <g class="cs__ticks">
          {ticks.map((i) => <rect x={170 + i * 16} y="62" width="9" height="30" rx="4.5" style={`--i:${i}`} />)}
        </g>
        <text class="cs__ask" x="766" y="92" text-anchor="end">?</text>
      </g>
    )
  }
</svg>

<style>
  .cs {
    width: 100%;
    height: auto;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
  }

  .cs__beads rect {
    fill: #1d1b18;
    stroke: rgba(243, 242, 236, 0.4);
    stroke-width: 1.5;
  }

  .cs__infill-edge,
  .cs__infill {
    fill: none;
    stroke-linejoin: round;
  }

  .cs__infill-edge {
    stroke: rgba(243, 242, 236, 0.4);
    stroke-width: 13;
  }

  .cs__infill {
    stroke: #1d1b18;
    stroke-width: 10;
  }

  .cs__coat {
    fill: var(--accent);
    transform-box: fill-box;
    transform-origin: left center;
  }

  .cs__coat-edge {
    stroke: var(--accent-hi);
    stroke-width: 2.5;
    transform-box: fill-box;
    transform-origin: left center;
  }

  .cs__marks circle {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2;
    transform-box: fill-box;
    transform-origin: center;
  }

  .cs__leak {
    fill: none;
    stroke: var(--liquid);
    stroke-width: 6;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
  }

  .cs__pool,
  .cs__drip,
  .cs__drop,
  .cs__bead-drop path:first-child {
    fill: var(--liquid);
  }

  .cs__pool {
    transform-box: fill-box;
    transform-origin: center bottom;
  }

  .cs__drop--in {
    opacity: 0.85;
  }

  .cs__glint {
    fill: none;
    stroke: #fff;
    stroke-width: 3;
    stroke-linecap: round;
    opacity: 0.7;
  }

  .cs__times,
  .cs__ask {
    font-family: var(--font-sans);
    font-size: 64px;
    letter-spacing: -0.05em;
    fill: var(--ink);
  }

  .cs__ask {
    fill: var(--accent-hi);
  }

  .cs__ticks rect {
    fill: var(--liquid);
  }

  /* ----------------------------------------------------------------
     Motion. It only runs inside the pinned story on Home, for the step
     on screen. Everywhere else the drawing is still and complete.
  ----------------------------------------------------------------- */
  :global(.is-live .is-active) .cs__marks circle {
    animation: cs-pulse 2.4s var(--ease) calc(var(--i) * 0.25s) infinite both;
  }

  :global(.is-live .is-active) .cs__drop--in {
    animation: cs-fall 0.7s cubic-bezier(0.5, 0, 0.9, 0.6) calc(var(--i) * 0.18s) both;
  }

  :global(.is-live .is-active) .cs__leak {
    animation: cs-draw 1.5s ease-in-out calc(0.55s + var(--i) * 0.18s) both;
  }

  :global(.is-live .is-active) .cs__drip {
    animation: cs-drip 1.1s ease-in calc(1.7s + var(--i) * 0.18s) infinite both;
  }

  :global(.is-live .is-active) .cs__pool {
    animation: cs-grow 0.8s var(--ease) calc(1.9s + var(--i) * 0.18s) both;
  }

  :global(.is-live .is-active) .cs--3 .cs__coat,
  :global(.is-live .is-active) .cs--3 .cs__coat-edge {
    animation: cs-brush 1.5s var(--ease) 0.15s both;
  }

  :global(.is-live .is-active) .cs--4 .cs__bead-drop {
    animation: cs-land 0.8s cubic-bezier(0.3, 1.3, 0.5, 1) calc(0.1s + var(--i) * 0.2s) both;
  }

  :global(.is-live .is-active) .cs--5 .cs__ticks rect {
    animation: cs-tick 0.3s ease-out calc(0.2s + var(--i) * 0.09s) both;
  }

  :global(.is-live .is-active) .cs--5 .cs__ask {
    animation: cs-ask 0.5s var(--ease) 2.2s both;
  }

  @keyframes cs-pulse {
    0%,
    100% {
      transform: scale(0.75);
      opacity: 0.35;
    }
    50% {
      transform: scale(1.15);
      opacity: 1;
    }
  }

  @keyframes cs-fall {
    from {
      transform: translateY(-90px);
      opacity: 0;
    }
  }

  @keyframes cs-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes cs-drip {
    from {
      transform: translateY(-34px);
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
    to {
      transform: translateY(62px);
      opacity: 0;
    }
  }

  @keyframes cs-grow {
    from {
      transform: scale(0);
    }
  }

  @keyframes cs-brush {
    from {
      transform: scaleX(0);
    }
  }

  @keyframes cs-land {
    from {
      transform: translateY(-120px);
      opacity: 0;
    }
  }

  @keyframes cs-tick {
    from {
      opacity: 0.15;
    }
  }

  @keyframes cs-ask {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
</style>
