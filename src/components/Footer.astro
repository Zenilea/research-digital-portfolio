---
import site from '../data/site.json';
import { url } from '../lib/url';
import Arrow from './Arrow.astro';
---

<footer class="footer">
  <div class="wrap footer__inner">
    <p class="footer__name">
      {site.name}
      <span>{site.course}</span>
    </p>
    <ul class="footer__links">
      {
        site.nav.map((item) => (
          <li>
            <a href={url(item.path)}>{item.label}</a>
          </li>
        ))
      }
    </ul>
    <p class="footer__meta">
      {site.email && <a class="footer__mail" href={`mailto:${site.email}`}>{site.email}</a>}
      <span>Last updated {site.lastUpdated}</span>
      <a href="#main" class="footer__top">Back to top <Arrow dir="up" /></a>
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding-block: clamp(2.5rem, 5vw, 4rem);
    font-size: 0.9rem;
    color: var(--ink-3);
  }

  .footer__inner {
    display: grid;
    gap: 1.5rem;
  }

  .footer__name {
    color: var(--ink);
    font-weight: 500;
  }

  .footer__name span {
    display: block;
    color: var(--ink-3);
    font-weight: 400;
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
  }

  .footer__links a,
  .footer__mail,
  .footer__top {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: 2.75rem;
    color: var(--ink-2);
    text-decoration: none;
  }

  .footer__links a:hover,
  .footer__mail:hover,
  .footer__top:hover {
    color: var(--ink);
  }

  .footer__top:hover :global(.arrow) {
    transform: translateY(-0.2em);
  }

  .footer__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
  }

  @media (min-width: 48em) {
    .footer__inner {
      grid-template-columns: 1fr auto 1fr;
      align-items: start;
    }

    .footer__meta {
      justify-content: flex-end;
      gap: 0.25rem 2rem;
    }
  }
</style>
