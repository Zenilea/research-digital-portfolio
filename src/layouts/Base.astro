---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';
import { url, absoluteUrl } from '../lib/url';

import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import geistLatinExt from '@fontsource-variable/geist/files/geist-latin-ext-wght-normal.woff2?url';
import serifLatin from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';

interface Props {
  /** Page name, shown before the site name in the browser tab. */
  title?: string;
  description?: string;
  /** Path of this page, like "/research/". */
  path: string;
  theme?: 'dark' | 'cream';
  /** Load the serif used for the hero title (Home only). */
  serif?: boolean;
}

const { title, description = site.description, path, theme = 'dark', serif = false } = Astro.props;

const pageTitle = title
  ? `${title} · ${site.name} · ${site.course}`
  : `${site.title} · ${site.name} · ${site.course}`;
const canonical = absoluteUrl(path, Astro.site);
const ogImage = absoluteUrl('/og.png', Astro.site);
const themeColor = theme === 'cream' ? '#f3f2ec' : '#0b0a09';

// Fonts are self-hosted. Only the Latin file is preloaded; the extended
// file (for names like Vaňková) loads only on pages that need it.
// The two "Fallback" faces resize Arial and Times New Roman to the measured
// width and height of the real fonts, so text does not jump when they load.
const fontCss = `
@font-face{font-family:'Geist Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url(${geistLatinExt}) format('woff2-variations');unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}
@font-face{font-family:'Geist Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url(${geistLatin}) format('woff2-variations');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'Geist Fallback';src:local('Arial'),local('Liberation Sans');size-adjust:105.85%;ascent-override:94.95%;descent-override:27.87%;line-gap-override:0%}
${
  serif
    ? `@font-face{font-family:'Instrument Serif';font-style:normal;font-display:swap;font-weight:400;src:url(${serifLatin}) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'Instrument Serif Fallback';src:local('Times New Roman'),local('Liberation Serif');size-adjust:84.64%;ascent-override:116.97%;descent-override:36.63%;line-gap-override:0%}`
    : ''
}`;
---

<!doctype html>
<html lang="en" class={theme === 'cream' ? 'theme-cream' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content={themeColor} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${site.name} · ${site.course}`} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Does the seal survive the cleaning? An AP Research project by Adhitya Harisudhakar."
    />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={url('/favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />

    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    {serif && <link rel="preload" href={serifLatin} as="font" type="font/woff2" crossorigin />}
    <style set:html={fontCss}></style>

    <script is:inline>
      // Runs before the first paint. "js" turns on the scroll-driven layouts,
      // "motion" turns on animation unless the visitor asked for less motion.
      (function (d) {
        d.classList.add('js');
        try {
          if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('motion');
        } catch (e) {}
      })(document.documentElement);
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="progress" aria-hidden="true"><span></span></div>
    <Nav path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
