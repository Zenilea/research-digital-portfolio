---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { url } from '../lib/url';
---

<Base path="/404.html" title="Page not found" description="This page is not on the site. Head back to the start of the project.">
  <section class="lost wrap">
    <p class="label"><b>404</b>Page not found</p>
    <h1 class="display">This page isn't here.</h1>
    <p class="lead">The link may be old, or the address may have a typo.</p>
    <p class="lost__links">
      <a class="btn" href={url('/')}>Go to the start <Arrow /></a>
      <a class="btn btn--ghost" href={url('/ideation/')}>See how the idea took shape</a>
    </p>
  </section>
</Base>

<style>
  .lost {
    display: grid;
    gap: 1.5rem;
    align-content: center;
    min-height: 70vh;
    padding-block: var(--section);
  }

  .lost__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }
</style>
